# ─── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/founderos

# ─── AI Provider (Puter.js) ────────────────────────────────
# FounderOS uses Puter.js as the single AI provider.
#
# To get an auth token:
#   1. Go to https://puter.com and sign in
#   2. Open browser dev tools → Application → Local Storage
#   3. Copy the value of "puter.auth.token" or "puter.auth.token.v2"
#   4. Paste it below:
#
# PUTER_AUTH_TOKEN=your-puter-auth-token-here
#
# Custom API origin (optional, default: https://api.puter.com):
# PUTER_API_ORIGIN=https://api.puter.com

# ─── Server ────────────────────────────────────────────────
PORT=5000
BASE_PATH=/

# ─── Supabase (optional — for auth) ────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Security (optional) ───────────────────────────────────
# N8N_WEBHOOK_SECRET=
# JWT_SECRET=
# ENCRYPTION_SECRET=

# ─── Database (required) ───────────────────────────────────────────
# Local Postgres, or run one with Docker (see README):
DATABASE_URL=postgresql://founderos:founderos@localhost:5432/founderos

# ─── Server ────────────────────────────────────────────────────────
PORT=5001
BASE_PATH=/
# Password that protects the whole app. Leave empty for local development only.
APP_PASSWORD=
# Optional: separate signing secret for sessions (defaults to APP_PASSWORD).
SESSION_SECRET=
# Set to 1 when running behind a reverse proxy that terminates TLS.
TRUST_PROXY=0

# ─── AI provider (set ONE; the first configured one is used) ───────
# Force a specific provider: anthropic | openai | openrouter | groq | ollama | puter
AI_PROVIDER=

# Anthropic (recommended). Default model: claude-opus-5-5
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# Optional reasoning effort for Claude: low | medium | high | xhigh | max
AI_EFFORT=

# OpenAI. Default model: gpt-5-mini
OPENAI_API_KEY=
OPENAI_MODEL=

# OpenRouter (any hosted model). Default model: anthropic/claude-sonnet-4.5
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Groq. Default model: llama-3.3-70b-versatile
GROQ_API_KEY=
GROQ_MODEL=

# Ollama (local, free). Default model: llama3.1
OLLAMA_BASE_URL=
OLLAMA_MODEL=

# Puter.js (legacy, browser-token based; not recommended for anything public)
PUTER_AUTH_TOKEN=

# ─── MCP (connect ChatGPT, Claude, Cursor) ─────────────────────────
# MCP stays off until this is set. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# Treat it like a password: anyone with it can read and edit your pipeline.
MCP_TOKEN=
# Public HTTPS address of this instance (deployment or tunnel). Used for links in tool results.
APP_URL=

# ─── Gmail sync (optional) ─────────────────────────────────────────
# Keeps each lead's last contact current from your email. Reads headers only
# (from, to, subject, time), never message bodies, and never sends email.
# Create a Google OAuth client (Web application) with the redirect URI
#   <your app URL>/api/integrations/gmail/callback
# e.g. http://localhost:5000/api/integrations/gmail/callback. Steps: README → Gmail sync.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: pin the redirect URI (defaults to APP_URL, else the browser's address).
GOOGLE_REDIRECT_URI=
# Minutes between syncs, and how many days back the first sync reads.
GMAIL_SYNC_INTERVAL_MINUTES=15
GMAIL_SYNC_LOOKBACK_DAYS=30

# ─── Networking ────────────────────────────────────────────────────
# Milliseconds Node waits on each server address before trying the next.
# Raise it on slow links if AI calls fail with UND_ERR_CONNECT_TIMEOUT.
NET_CONNECT_ATTEMPT_MS=2500

# ─── Personalisation ───────────────────────────────────────────────
# Used in prompts and email sign-offs when no founder profile name is stored.
FOUNDER_NAME=

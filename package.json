{
  "name": "founderos",
  "version": "0.1.0",
  "description": "Open-source, self-hosted AI sales assistant for solo founders. Flags deals going quiet, drafts the follow-up email, and works inside ChatGPT and Claude via MCP.",
  "keywords": [
    "ai-crm",
    "crm",
    "self-hosted",
    "open-source-crm",
    "sales-automation",
    "sales-pipeline",
    "lead-management",
    "follow-up",
    "ai-agent",
    "mcp-server",
    "model-context-protocol",
    "chatgpt",
    "claude",
    "ollama",
    "solopreneur",
    "indie-hackers"
  ],
  "homepage": "https://github.com/rahulsinghnegiii/Founder-OS#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rahulsinghnegiii/Founder-OS.git"
  },
  "bugs": {
    "url": "https://github.com/rahulsinghnegiii/Founder-OS/issues"
  },
  "author": "Rahul Singh Negi (https://github.com/rahulsinghnegiii)",
  "license": "MIT",
  "scripts": {
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "dev:api": "pnpm --filter @workspace/api-server run dev",
    "dev:web": "pnpm --filter @workspace/founder-os run dev",
    "db:push": "pnpm --filter @workspace/db run push-force",
    "seed": "pnpm --filter @workspace/scripts run seed",
    "seed:demo": "pnpm --filter @workspace/scripts run seed -- --demo"
  },
  "private": true,
  "devDependencies": {
    "prettier": "^3.8.3",
    "typescript": "~5.9.3"
  },
  "packageManager": "pnpm@10.33.3",
  "optionalDependencies": {
    "@rollup/rollup-win32-x64-msvc": "4.60.3",
    "@tailwindcss/oxide-win32-x64-msvc": "4.3.0",
    "lightningcss-win32-x64-msvc": "1.32.0"
  }
}

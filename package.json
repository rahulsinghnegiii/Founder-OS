{
  "name": "founderos",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "dev:api": "pnpm --filter @workspace/api-server run dev",
    "dev:web": "pnpm --filter @workspace/founder-os run dev",
    "db:push": "pnpm --filter @workspace/db run push-force",
    "seed": "pnpm --filter @workspace/scripts run seed",
    "seed:demo": "pnpm --filter @workspace/scripts run seed -- --demo"
  },
  "private": true,
  "devDependencies": {
    "prettier": "^3.8.3",
    "typescript": "~5.9.3"
  },
  "packageManager": "pnpm@10.33.3",
  "optionalDependencies": {
    "@rollup/rollup-win32-x64-msvc": "4.60.3",
    "@tailwindcss/oxide-win32-x64-msvc": "4.3.0",
    "lightningcss-win32-x64-msvc": "1.32.0"
  }
}
